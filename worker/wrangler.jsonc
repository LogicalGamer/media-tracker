{
  // Cloudflare Worker config. Deploy with: npm run deploy
  // Secrets (TMDB_TOKEN, IGDB_CLIENT_ID, IGDB_CLIENT_SECRET, APP_KEY) are set
  // with `npx wrangler secret put <NAME>` and never stored in this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-tracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // At most 300 requests per minute from one IP address (see src/index.ts).
  // Normal use is far below this; it stops one person from using up the shared daily quota.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }]
}
